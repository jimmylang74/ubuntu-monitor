#!/bin/sh
# Stop the service before files are removed or replaced.
set -e

if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|upgrade|deconfigure)
            systemctl stop power-monitor.service >/dev/null 2>&1 || true
            systemctl disable power-monitor.service >/dev/null 2>&1 || true
            ;;
    esac
fi

exit 0
