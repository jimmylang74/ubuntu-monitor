#!/bin/sh
# Read powercap energy counters as root and emit tab-separated records.
# Mainline Linux also registers AMD Zen RAPL under intel-rapl:*, so no vendor
# check is needed here.  Installed root-owned; invoked via sudo -n.
set -eu

for d in /sys/class/powercap/*:*; do
    [ -d "$d" ] || continue
    [ -f "$d/energy_uj" ] || continue
    id=${d##*/}
    name=$(cat "$d/name" 2>/dev/null || printf '')
    energy=$(cat "$d/energy_uj" 2>/dev/null || printf '')
    max=$(cat "$d/max_energy_range_uj" 2>/dev/null || printf '')
    enabled=$(cat "$d/enabled" 2>/dev/null || printf '')
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$energy" "$max" "$enabled"
done